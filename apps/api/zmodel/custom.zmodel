abstract model g_base {
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?
}

abstract model g_base_min {
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model aa_classroom_groups extends g_base {
    id          Int                          @id @default(autoincrement())
    course_id   Int
    group_name  String                       @length(max: 100)
    description String                       @length(max: 255)
    cover       String                       @length(max: 100)
    avatar      String                       @length(max: 100)
    created_by  BigInt                       @default(auth().ID) @db.UnsignedBigInt

    users_group aa_classroom_group_members[]
}

model aa_classroom_group_members {
    id         Int                 @id @default(autoincrement())
    user_id    BigInt
    group_id   Int
    group      aa_classroom_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    role       GroupRole           @default(THANHVIEN)
    order      Int // số thứ tự của mỗi học viên trong nhóm -> thứ tự đệ nhị thân

    created_by BigInt              @default(auth().ID) @db.UnsignedBigInt // tạo 1 user là robot sử dụng cho các hoạt động tự động hoá như auto thêm học viên vào group lớp
    created_at DateTime            @default(now())
}

model aa_attendance {
    id         Int              @id @default(autoincrement())
    user_id    BigInt
    course_id  Int
    lesson_id  Int
    status     AttendanceStatus
    created_at DateTime         @default(now())
}

model aa_activity_type {
    id         Int           @id @default(autoincrement())
    name       String        @length(max: 30)
    icon       String        @length(max: 100)
    created_at DateTime      @default(now())
    updated_at DateTime      @updatedAt

    activities aa_activity[]
}

model aa_activity extends g_base_min {
    id            Int                @id @default(autoincrement())
    type_id       Int
    type          aa_activity_type   @relation(fields: [type_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    post_id       Int // ! làm sao để validate được post_id này thuộc sở hữu của user đang tạo activity này mỗi khi INSERT
    name          String             @length(max: 255)
    min_count     Int                @default(1)
    end_date      DateTime?

    activity_logs aa_activity_logs[]
}

model aa_activity_logs extends g_base_min {
    id          BigInt         @id @default(autoincrement())
    activity_id Int
    activity    aa_activity    @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    content     String         @length(max: 500)
    status      ActivityStatus

    created_by  BigInt         @default(auth().ID) @db.UnsignedBigInt
}

model aa_activity_relationships {
    id              Int      @id @default(autoincrement())
    user_id         BigInt
    activity_id     Int
    activity_log_id BigInt
    created_at      DateTime @default(now())
}

enum ActivityStatus {
    PUBLISH
    DRAFT
}

enum AttendanceStatus {
    TRONVEN
    VANGMAT
    MUON
}

enum GroupRole {
    TRUONGTHON
    PHOTHON
    THANHVIEN
}
